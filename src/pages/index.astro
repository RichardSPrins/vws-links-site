---
import BaseLayout from "../layouts/BaseLayout.astro";
import headshot from "../assets/headshot.png";

export const prerender = true;

const calendarUrl =
  "https://api.velocitywebstudio.com/widget/booking/mcWyJi4NDQ1tg3JDZlYS";

const stats = [
  { n: "46%", l: "of all Google searches are local" },
  {
    n: "88%",
    l: "of people who run a local search call or visit within 24 hours",
  },
  { n: "97%", l: "of Google users have used search to find a local business" },
  { n: "900%", l: "growth in 'near me' searches in recent years" },
];

const problemPoints = [
  "It's that you can't answer the phone at 9pm while you're on a job.",
  "It's that the competitors ranking above you on Google aren't better. They're just running a system you don't have.",
  "It's that you've been sold 'marketing services' by people who never installed the whole system end to end.",
  "It's that you're trying to do the work, figure out Google, post weekly, chase reviews, and respond to leads in 60 seconds, all at the same time.",
  "It's that the agencies you've worked with sold you one piece of the puzzle and called it marketing.",
];

const differentiators = [
  {
    h: "End to end, not piecemeal.",
    p: "Most agencies sell one piece. SEO, or ads, or a website. We install all five: visibility, capture, follow-up, paid traffic, organic SEO. Pieces don't compound. Systems do.",
  },
  {
    h: "Done for you, not done with you.",
    p: "You don't learn the tools. You don't manage the CRM. You don't post weekly. We run it. You do the work you're already good at.",
  },
  {
    h: "Built to produce fast.",
    p: "The system is engineered to start putting qualified leads in front of you inside the first 60 days. Most of our clients see it pay for itself before the second month closes. We've run this enough times across niches and service areas to know what the curve looks like.",
  },
  {
    h: "Your category, closed to your competitors.",
    p: "We don't sell the same playbook to the three businesses ranked above and below you. When you sign, your category in your city is closed to everyone else. It isn't a scarcity tactic. It's the only way the system stays fair to the people we already work with.",
  },
  {
    h: "Month to month, no contracts.",
    p: "You stay because it's working, not because you're locked in. If we're not earning the spend, you shouldn't be paying it.",
  },
  {
    h: "Compounds over time.",
    p: "Campaigns end. Systems compound. The infrastructure we install keeps producing leads after the ad budget pauses. That's the difference between renting leads and owning them.",
  },
];

const process = [
  {
    when: "Week 1",
    h: "Audit and strategy",
    p: "We map your current Google presence, find the leaks in your lead flow, and benchmark you against the businesses ranking above you. You get a clear install plan with no fluff.",
  },
  {
    when: "Weeks 2 to 3",
    h: "Build and install",
    p: "We set up the full stack. Google Business Profile optimization, review system, missed-call text-back, follow-up sequences, ad accounts, tracking. Everything wired and live.",
  },
  {
    when: "Week 4",
    h: "Launch",
    p: "The system goes on. Leads start coming through.",
  },
  {
    when: "Week 5 and beyond",
    h: "Run, refine, scale",
    p: "We work the system every week. You get weekly performance reports. We optimize what's working and kill what isn't. The longer it runs, the better it gets.",
  },
];

const aboutParas = [
  "I'm Richard Prins. I run Velocity Web Studio out of Boise.",
  "I started this company after years of watching capable local service businesses pay good money to agencies that sold them one piece of a system and called it marketing. SEO retainer over here. A few hundred bucks a month in ads over there. A website that looked nice but didn't generate anything. Meanwhile the actual machine that drives compounding local leads, the one that connects all of it, sat un-installed in their business.",
  "It made me a little crazy, honestly. These were good operators. Real businesses. Solid work. They just kept hiring vendors who were happy to sell features and ghost on outcomes.",
  "So I built the agency I wished those owners had been able to hire. End to end. Run by the person who built it. No account managers, no handoffs, no junior trying to find your business on a map. If you sign with Velocity, you're working with me directly. That's the deal.",
];

const aboutBeats = [
  "I'm direct. I'll tell you what I think will work and what I don't think is worth your money, even when what I don't think is worth your money is one of our own services. I'd rather lose a sale than sell you something you don't need.",
  "I answer my own phone. If you text me on a Tuesday, you'll hear back from me on Tuesday, not from someone copied on the thread three layers down.",
  "I care about local. I live here. The businesses we help are the ones I drive past on my way home. The work is personal in a way it can't be when the agency is in another time zone.",
];

const testimonials = [
  {
    q: "The missed-call text-back paid for the first 6 months in one week. Caught a roof job that would have gone to a competitor.",
    n: "Carlos R.",
    r: "Painter, Boise, ID",
    initials: "CR",
  },
  {
    q: "I was ranked 8th. Now I'm ranked first in two cities and second in the third. Calls have basically tripled.",
    n: "Lisa M.",
    r: "Med Spa Owner, Eagle, ID",
    initials: "LM",
  },
  {
    q: "I thought I needed to spend on ads. Turns out I just needed someone running the system every week. The needle started moving in week three and hasn't stopped.",
    n: "Daniel",
    r: "HVAC Owner, Ada County, ID",
    initials: "DA",
  },
];

const faqs = [
  {
    q: "How long until I see leads?",
    a: "Most clients see qualified leads inside the first 60 days. Some see them in week three. The variable isn't the system, it's where your business is starting from (existing Google presence, review count, market competitiveness).",
  },
  {
    q: "What if I'm already running ads?",
    a: "Good. We'll audit what's running, fix what's broken, and plug it into the rest of the system. You don't lose what you've already built.",
  },
  {
    q: "Do you handle my Google Business Profile, or do I?",
    a: "We handle it. You don't touch a thing unless you want to. Most owners hand us the keys on day one and never look back.",
  },
  {
    q: "Do I have to sign a contract?",
    a: "No. Month to month. You stay because it's working.",
  },
  {
    q: "What does it cost?",
    a: "Depends on what your business needs. We don't believe in flat-rate packages that pretend every business is the same. The 45-minute call gives you a real number based on what's actually right for you, not a guess.",
  },
  {
    q: "What if it doesn't work?",
    a: "Then it doesn't work and we both move on. Month-to-month means you're never trapped paying for something that isn't producing.",
  },
];
---

<BaseLayout>
  <!-- NAV -->
  <header
    class="sticky top-0 z-50 backdrop-blur-md bg-ink/80 border-b border-cream/5"
  >
    <div
      class="max-w-6xl mx-auto px-6 lg:px-8 h-16 flex items-center justify-between"
    >
      <a
        href="/"
        class="flex items-center gap-2.5"
        aria-label="Velocity Web Studio home"
      >
        <span
          class="inline-flex h-2.5 w-2.5 rounded-full bg-brand-500 shadow-[0_0_12px_var(--color-brand-500)]"
          aria-hidden="true"></span>
        <span class="font-display font-extrabold tracking-tight text-cream text-[17px]">
          Velocity <span class="text-brand-500">Web</span>
        </span>
      </a>
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium">
        <a href="#problem" class="text-cream/70 hover:text-cream transition"
          >Problem</a
        >
        <a href="#solution" class="text-cream/70 hover:text-cream transition"
          >Solution</a
        >
        <a href="#about" class="text-cream/70 hover:text-cream transition"
          >About</a
        >
        <a href="#faq" class="text-cream/70 hover:text-cream transition">FAQ</a>
      </nav>
      <a
        href={calendarUrl}
        class="inline-flex items-center gap-1.5 rounded-full bg-brand-500 text-cream px-4 py-2 text-sm font-bold hover:bg-brand-600 transition shadow-lg shadow-brand-500/20"
      >
        Book a Call
      </a>
    </div>
  </header>

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div
      aria-hidden
      class="absolute -top-32 -right-40 h-[500px] w-[500px] rounded-full bg-brand-500/15 blur-3xl"
    >
    </div>
    <div
      aria-hidden
      class="absolute top-40 -left-40 h-[420px] w-[420px] rounded-full bg-brand-600/10 blur-3xl"
    >
    </div>

    <div
      class="relative max-w-4xl mx-auto px-6 lg:px-8 pt-20 lg:pt-28 pb-20 lg:pb-24 text-center"
    >
      <div
        class="inline-flex items-center gap-2 rounded-full border border-cream/10 bg-ink-2/70 px-3 py-1.5 text-xs font-semibold tracking-wide uppercase text-cream/65 backdrop-blur"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-brand-500 animate-pulse"
        ></span>
        Free tool for local service businesses
      </div>

      <h1
        class="mt-7 font-display text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[0.98] text-balance text-cream"
      >
        Get more 5-star Google reviews.
        <span class="block mt-2 text-cream/40">
          <span
            class="bg-gradient-to-r from-brand-500 via-brand-600 to-brand-400 bg-clip-text text-transparent"
            >Catch the bad ones</span
          >
          before they go public.
        </span>
      </h1>

      <p
        class="mt-7 text-lg md:text-xl text-cream/60 max-w-2xl mx-auto leading-relaxed text-pretty"
      >
        We built a free done-for-you review tool and we'll set it up for your
        business inside 48 hours. It sends your happy customers straight to
        your Google review page. It routes the unhappy ones to a private form
        so you can fix the issue before it ever lands on your profile. Yours
        to keep, no strings.
      </p>

      <form
        class="mt-10 mx-auto max-w-xl flex flex-col sm:flex-row gap-2 p-2 rounded-2xl bg-ink-2 ring-1 ring-cream/10 shadow-2xl shadow-black/40"
        id="leadForm"
        novalidate
      >
        <label class="sr-only" for="leadEmail">Your business email</label>
        <input
          class="flex-1 bg-transparent px-4 py-3 text-base text-cream placeholder:text-cream/40 outline-none rounded-xl focus:bg-ink-3 transition"
          type="email"
          id="leadEmail"
          name="email"
          placeholder="Your business email"
          required
          autocomplete="email"
        />
        <button
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 text-cream px-6 py-3 text-sm font-bold hover:bg-brand-600 transition whitespace-nowrap shadow-lg shadow-brand-500/25"
          type="submit"
        >
          <span class="lead-submit-label">Get my free review tool</span>
          <span aria-hidden>→</span>
        </button>
      </form>

      <p class="mt-4 text-sm text-cream/55">
        Live in 48 hours. Yours forever, even if we never work together again.
      </p>

      <p
        class="mt-10 text-sm text-cream/45 tracking-wide"
      >
        Built for local service businesses across Boise and the Treasure
        Valley.
      </p>
    </div>
  </section>

  <!-- STATS -->
  <section class="relative bg-ink-2 border-y border-cream/5">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-20 lg:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>Local search reality
          <span class="h-px w-8 bg-brand-500"></span>
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
        >
          The customers are already searching. The only question is whether
          your business shows up.
        </h2>
      </div>

      <div class="mt-14 grid grid-cols-2 lg:grid-cols-4 gap-5">
        {
          stats.map((s) => (
            <div class="rounded-2xl bg-ink-3 p-6 ring-1 ring-cream/5 text-center">
              <p class="text-4xl lg:text-5xl font-extrabold tracking-tight bg-gradient-to-br from-brand-500 to-brand-400 bg-clip-text text-transparent">
                {s.n}
              </p>
              <p class="mt-3 text-sm text-cream/65 leading-snug text-pretty">
                {s.l}
              </p>
            </div>
          ))
        }
      </div>

      <p
        class="mt-10 text-center text-lg text-cream/75 max-w-2xl mx-auto text-pretty"
      >
        If your business isn't installed as the answer to those searches, the
        business down the street is.
      </p>
    </div>
  </section>

  <!-- PROBLEM -->
  <section id="problem" class="relative bg-ink">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>The real problem
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] text-balance text-cream"
        >
          You're not behind because you're bad at marketing.
          <span class="text-brand-500"
            >You're behind because nobody installed the system.</span
          >
        </h2>
      </div>

      <div class="mt-12 space-y-6 text-lg leading-relaxed text-pretty">
        <p class="text-cream/85 font-medium">
          You already have customers. You're a good operator. The work you do
          is solid. The reason your phone isn't ringing the way it should
          isn't a skill problem.
        </p>

        <ul class="space-y-3">
          {
            problemPoints.map((p) => (
              <li class="flex items-start gap-3 rounded-xl bg-ink-2 ring-1 ring-cream/5 p-4 text-cream/80">
                <span
                  class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500/15 text-brand-500 text-[11px] font-black"
                  aria-hidden="true"
                >
                  →
                </span>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>

        <p class="text-cream/60">
          Nobody can do all of that themselves. The owners winning in your
          market aren't doing it themselves either. They installed the system
          that does it for them.
        </p>

        <p
          class="relative rounded-2xl bg-ink-2 ring-1 ring-cream/5 p-6 text-xl font-semibold leading-snug text-pretty text-cream"
        >
          <span
            aria-hidden
            class="absolute left-0 top-4 bottom-4 w-1 rounded-r-full bg-brand-500"
          ></span>
          <span class="block pl-3">
            That's the gap. Not your skill. Not your effort. The system.
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- DIFFERENTIATORS -->
  <section id="solution" class="relative bg-ink-2 border-y border-cream/5">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl mx-auto text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>The solution
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
        >
          Why this works when the other things haven't.
        </h2>
      </div>

      <div class="mt-14 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          differentiators.map((d, i) => (
            <div class="group relative rounded-2xl bg-ink-3 p-7 ring-1 ring-cream/5 hover:ring-brand-500/40 hover:shadow-xl hover:shadow-brand-500/5 transition-all">
              <span class="text-[10px] font-bold uppercase tracking-widest text-cream/30">
                0{i + 1}
              </span>
              <h3 class="mt-3 text-lg font-bold tracking-tight text-brand-500 leading-snug">
                {d.h}
              </h3>
              <p class="mt-3 text-[15px] text-cream/65 leading-relaxed text-pretty">
                {d.p}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="relative bg-ink">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl mx-auto text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>How it works
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
        >
          What happens after you sign.
        </h2>
      </div>

      <ol class="mt-14 grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          process.map((step, i) => (
            <li class="relative rounded-2xl bg-ink-2 p-6 ring-1 ring-cream/5 h-full flex flex-col">
              <p class="text-5xl font-extrabold tracking-tight bg-gradient-to-br from-brand-500 to-brand-400 bg-clip-text text-transparent leading-none">
                0{i + 1}
              </p>
              <p class="mt-4 text-[10px] font-bold uppercase tracking-[0.18em] text-cream/45">
                {step.when}
              </p>
              <h3 class="mt-1 text-lg font-bold tracking-tight text-cream">
                {step.h}
              </h3>
              <p class="mt-3 text-sm text-cream/65 leading-relaxed text-pretty flex-1">
                {step.p}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="relative bg-ink-2 border-y border-cream/5">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="grid lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <p
            class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
          >
            <span class="h-px w-8 bg-brand-500"></span>About
          </p>
          <h2
            class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
          >
            The guy who'll actually be running your account.
          </h2>

          <div class="mt-8 space-y-5 text-lg leading-relaxed text-cream/70 text-pretty">
            {aboutParas.map((p) => <p>{p}</p>)}
          </div>

          <p class="mt-8 text-cream font-semibold">
            A few things you should know about how I work:
          </p>
          <ul class="mt-4 space-y-3">
            {
              aboutBeats.map((b) => (
                <li class="flex items-start gap-3 text-cream/75 leading-relaxed text-pretty">
                  <span
                    class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500/15 text-brand-500 text-[11px] font-black"
                    aria-hidden="true"
                  >
                    →
                  </span>
                  <span>{b}</span>
                </li>
              ))
            }
          </ul>

          <p
            class="mt-8 relative rounded-2xl bg-ink-3 ring-1 ring-cream/5 p-6 text-lg font-medium leading-snug text-pretty text-cream"
          >
            <span
              aria-hidden
              class="absolute left-0 top-4 bottom-4 w-1 rounded-r-full bg-brand-500"
            ></span>
            <span class="block pl-3">
              If we work together, you'll hear from me regularly. Not a
              portal. Not a robot. Me.
            </span>
          </p>

          <p class="mt-5 text-sm text-cream/45 italic">
            Richard Prins, Velocity Web Studio
          </p>
        </div>

        <div class="lg:col-span-5 order-1 lg:order-2">
          <div class="relative max-w-sm mx-auto lg:mx-0 lg:ml-auto">
            <div
              aria-hidden
              class="absolute -inset-4 rounded-3xl bg-brand-500/15 blur-2xl"
            >
            </div>
            <div
              class="relative rounded-3xl overflow-hidden ring-1 ring-cream/10 shadow-2xl shadow-black/40"
            >
              <img
                src={headshot.src}
                alt="Richard Prins, Velocity Web Studio"
                class="w-full aspect-square object-cover object-[center_18%]"
                loading="lazy"
              />
            </div>
            <div
              class="absolute -bottom-3 -left-3 inline-flex items-center gap-2 rounded-full bg-ink-3 px-3 py-1.5 text-xs font-bold ring-1 ring-cream/10 shadow-lg text-cream"
            >
              <span
                class="inline-flex h-1.5 w-1.5 rounded-full bg-brand-500"
              ></span>
              Boise, Idaho
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="relative bg-ink">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl mx-auto text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>Testimonials
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
        >
          How you know this is real.
        </h2>
      </div>

      <div class="mt-14 grid md:grid-cols-3 gap-5">
        {
          testimonials.map((t, i) => (
            <figure
              class:list={[
                "relative flex flex-col rounded-2xl p-7 ring-1 transition-all",
                i === 1
                  ? "bg-ink-3 ring-brand-500/30 shadow-xl shadow-brand-500/5"
                  : "bg-ink-2 ring-cream/5 hover:ring-cream/15",
              ]}
            >
              <span class="text-5xl font-extrabold leading-none text-brand-500">
                "
              </span>
              <blockquote class="mt-2 text-base leading-relaxed font-medium text-pretty flex-1 text-cream">
                {t.q}
              </blockquote>
              <figcaption class="mt-6 flex items-center gap-3">
                <span class="h-10 w-10 rounded-full bg-gradient-to-br from-brand-500 to-brand-400 flex items-center justify-center text-xs font-black text-cream shrink-0">
                  {t.initials}
                </span>
                <div>
                  <p class="text-sm font-bold text-cream">{t.n}</p>
                  <p class="text-xs text-cream/55">{t.r}</p>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <p class="mt-8 text-center text-xs text-cream/40 italic">
        Testimonials reflect representative client outcomes. Real attributed
        reviews available on request.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="relative bg-ink-2 border-y border-cream/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="text-center max-w-2xl mx-auto">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>FAQ
          <span class="h-px w-8 bg-brand-500"></span>
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
        >
          Questions worth answering before the call.
        </h2>
      </div>

      <div class="mt-12 space-y-3">
        {
          faqs.map((f, i) => (
            <details
              class="group rounded-2xl bg-ink-3 ring-1 ring-cream/5 open:ring-brand-500/40 transition-all"
              open={i === 0}
            >
              <summary class="cursor-pointer list-none flex items-center justify-between gap-4 p-6 font-semibold text-lg tracking-tight text-balance text-cream">
                {f.q}
                <span class="shrink-0 inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-500/15 text-brand-500 text-lg font-black transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <div class="px-6 pb-6 -mt-1 text-cream/65 leading-relaxed text-pretty">
                {f.a}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

