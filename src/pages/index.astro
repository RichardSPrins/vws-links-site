  <!-- LEAD FORM + EXIT INTENT JS -->
  <script is:inline>
    (function () {
      const SUBMITTED_KEY = "vws-lead-submitted";
      const EXIT_SHOWN_KEY = "vws-exit-shown";

      // Wire any form marked [data-lead-form].
      // TODO: replace stub with GHL webhook POST.
      document.querySelectorAll("[data-lead-form]").forEach((form) => {
        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const input = form.querySelector('input[name="email"]');
          const btn = form.querySelector('button[type="submit"]');
          const label = btn.querySelector(".lead-submit-label");
          if (!input.value || !input.checkValidity()) {
            input.focus();
            return;
          }
          btn.classList.remove("bg-brand-500", "hover:bg-brand-600");
          btn.classList.add("bg-emerald-600", "shadow-emerald-600/25");
          if (label) label.textContent = "Got it. Check your inbox.";
          input.value = "";
          sessionStorage.setItem(SUBMITTED_KEY, "1");
        });
      });

      // Exit intent popup
      const dialog = document.getElementById("exitDialog");
      if (!dialog || typeof dialog.showModal !== "function") return;

      const closeBtn = document.getElementById("exitDialogClose");
      const dismissBtn = document.getElementById("exitDialogDismiss");

      function markShown() {
        sessionStorage.setItem(EXIT_SHOWN_KEY, "1");
      }
      function alreadyHandled() {
        return (
          sessionStorage.getItem(EXIT_SHOWN_KEY) === "1" ||
          sessionStorage.getItem(SUBMITTED_KEY) === "1"
        );
      }
      function openDialog() {
        if (alreadyHandled() || dialog.open) return;
        markShown();
        dialog.showModal();
      }
      function closeDialog() {
        if (dialog.open) dialog.close();
      }

      closeBtn?.addEventListener("click", closeDialog);
      dismissBtn?.addEventListener("click", closeDialog);

      // Click backdrop to close
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) closeDialog();
      });

      // Once popup is submitted, close it
      document
        .getElementById("exitLeadForm")
        ?.addEventListener("submit", () => {
          setTimeout(closeDialog, 1200);
        });

      // Trigger logic: mouseleave from top (desktop only).
      // 5-second grace period after load to avoid false fires.
      let armed = false;
      setTimeout(() => {
        armed = true;
      }, 5000);

      document.addEventListener("mouseleave", (e) => {
        if (!armed) return;
        if (e.clientY <= 0) openDialog();
      });

      // Mobile / touch fallback: open on hard scroll-up after meaningful scroll depth.
      let lastY = window.scrollY;
      let maxY = 0;
      const isTouch = window.matchMedia("(pointer: coarse)").matches;
      if (isTouch) {
        window.addEventListener(
          "scroll",
          () => {
            const y = window.scrollY;
            if (y > maxY) maxY = y;
            // Triggered if user scrolled past 60% of viewport and then quickly scrolls back up to the top.
            if (
              armed &&
              maxY > window.innerHeight * 0.6 &&
              y < 80 &&
              lastY > 200
            ) {
              openDialog();
            }
            lastY = y;
          },
          { passive: true }
        );
      }
    })();
  </script>
