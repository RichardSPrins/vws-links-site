---
import BaseLayout from "../layouts/BaseLayout.astro";
import headshot from "../assets/headshot.png";

export const prerender = true;

const calendarUrl =
  "https://api.velocitywebstudio.com/widget/booking/mcWyJi4NDQ1tg3JDZlYS";

const stats = [
  { n: "46%", l: "of all Google searches are local" },
  {
    n: "88%",
    l: "of people who run a local search call or visit within 24 hours",
  },
  { n: "97%", l: "of Google users have used search to find a local business" },
  { n: "900%", l: "growth in 'near me' searches in recent years" },
];

const problemPoints = [
  "Your Google Business Profile is a half-finished placeholder.",
  "Your website is a brochure, not a lead-generating asset.",
  "Your Facebook page hasn't been touched in eight months.",
  "Your email list, if you have one, is sitting in a spreadsheet you haven't opened since 2023.",
  "No two of those pieces are talking to each other, and nobody has ever sat down and built them as one system.",
];

const pillars = [
  {
    n: "Pillar 1",
    h: "Google Business Profile",
    p: "The map pack is where local searches end. Your GBP is the only asset that puts you in front of buyers at the exact moment they decide to call someone. We set it up, optimize it, post weekly, manage your reviews, and keep it pulling traffic toward your business 24 hours a day.",
  },
  {
    n: "Pillar 2",
    h: "Website",
    p: "Not a brochure. A 15 to 35 page authority asset built around your services, your service areas, and the questions your customers actually search. Schema-tagged, conversion-focused, and fully integrated with your GBP. The site does the work of selling once Google has done the work of finding.",
  },
  {
    n: "Pillar 3",
    h: "Facebook",
    p: "Most local businesses treat Facebook like an obligation. We treat it like a trust signal. Your page becomes a steady stream of evidence that you're real, you're active, and you're worth picking over the competition. Optimized profile, weekly posts, response management.",
  },
  {
    n: "Pillar 4",
    h: "Email",
    p: "The asset most local businesses never build. Front-end nurture catches the leads who aren't ready to buy yet and walks them in over time. Back-end retention keeps your existing customers coming back, referring you, and remembering you exist when the next job comes up.",
  },
];

const tiers = [
  {
    name: "Launch",
    tag: "The foundation tier",
    best: "Businesses ready to plant the flag.",
    body: "We install the base of all four pillars, get your Google profile dominant in your immediate service area, and build out your website month by month. Steady progress. Lowest monthly commitment. Slowest path to the full destination, but every dollar is moving you forward.",
    highlighted: false,
    badge: null,
  },
  {
    name: "Accelerate",
    tag: "The growth tier",
    best: "Businesses ready to move faster.",
    body: "Same destination, but we build twice as much each month, automate most of the manual work, and add front-end email so you stop losing leads who weren't ready to buy on day one. This is where most Velocity clients start.",
    highlighted: true,
    badge: "Most clients start here",
  },
  {
    name: "Velocity",
    tag: "The dominance tier",
    best: "Businesses already producing revenue and ready to push past their local competition.",
    body: "We set up every pillar in the first 30 days, run daily activity on your GBP, fire both front-end and back-end email, and use GeoGrid data to attack the exact zip codes where your competitors are winning. This is the autopilot tier for owners who want to stop thinking about marketing and just see the leads come in.",
    highlighted: false,
    badge: null,
  },
];

const differentiators = [
  {
    h: "Done for you, not done with you.",
    p: "You don't learn the tools. You don't manage the CRM. You don't post weekly. We run it. You do the work you're already good at.",
  },
  {
    h: "Your category, closed to your competitors.",
    p: "We don't sell the same playbook to the three businesses ranked above and below you. When you sign, your category in your city is closed to everyone else. It isn't a scarcity tactic. It's the only way the system stays fair to the people we already work with.",
  },
  {
    h: "Month to month, no contracts.",
    p: "You stay because it's working, not because you're locked in. If we're not earning the spend, you shouldn't be paying it.",
  },
  {
    h: "Run by the person who built it.",
    p: "You're working with me directly. No account managers, no handoffs, no junior trying to find your business on a map. If you sign with Velocity, you get my phone number and my actual attention.",
  },
];

const process = [
  {
    when: "Week 1",
    h: "Audit and strategy",
    p: "We map your current setup across all four pillars, find the leaks, benchmark you against your top local competitors, and lock in the install plan for your tier. You get a clear picture of where you are and where we're going.",
  },
  {
    when: "Weeks 2 to 4",
    h: "Install",
    p: "We build the base of every pillar. GBP optimized and producing. Foundation website live with your core service pages. Facebook profile rebuilt and posting. Email tooling set up and ready to capture. By the end of this window, the foundation is in.",
  },
  {
    when: "Month 2 onward",
    h: "Run and expand",
    p: "The system starts producing. We continue building out website pages, running GBP posts, expanding your email program, and refining everything based on what the data tells us. The longer it runs, the more it compounds.",
  },
];

const aboutParas = [
  "I'm Richard Prins. I run Velocity Web Studio out of Boise.",
  "I started this company after years of watching capable local service businesses pay good money to agencies that sold them one piece of a system and called it marketing. SEO retainer over here. A few hundred bucks a month in ads over there. A website that looked nice but didn't generate anything. Meanwhile the four pillars that actually drive compounding local growth sat un-installed in their business.",
  "It made me a little crazy, honestly. These were good operators. Real businesses. Solid work. They just kept hiring vendors who were happy to sell features and ghost on outcomes.",
  "So I built the agency I wished those owners had been able to hire. End to end. Run by the person who built it. No account managers, no handoffs.",
];

const aboutBeats = [
  "I'm direct. I'll tell you what I think will work and what I don't think is worth your money, even when what I don't think is worth your money is one of our own services. I'd rather lose a sale than sell you something you don't need.",
  "I answer my own phone. If you text me on a Tuesday, you'll hear back from me on Tuesday, not from someone copied on the thread three layers down.",
  "I care about local. I live here. The businesses we help are the ones I drive past on my way home. The work is personal in a way it can't be when the agency is in another time zone.",
];

const testimonials = [
  {
    q: "The missed-call text-back paid for the first 6 months in one week. Caught a roof job that would have gone to a competitor.",
    n: "Carlos R.",
    r: "Painter, Boise, ID",
    initials: "CR",
  },
  {
    q: "I was ranked 8th. Now I'm ranked first in two cities and second in the third. Calls have basically tripled.",
    n: "Lisa M.",
    r: "Med Spa Owner, Eagle, ID",
    initials: "LM",
  },
  {
    q: "I thought I needed to spend on ads. Turns out I just needed someone running the system every week. The needle started moving in week three and hasn't stopped.",
    n: "Daniel",
    r: "HVAC Owner, Ada County, ID",
    initials: "DA",
  },
];

const faqs = [
  {
    q: "How long until I see leads?",
    a: "Most clients see qualified leads inside the first 60 days. Some see them in week three. The variable isn't the system, it's where your business is starting from (existing Google presence, review count, market competitiveness) and which tier you're on.",
  },
  {
    q: "What if I'm already running ads?",
    a: "Good. We'll audit what's running and either fold it into the system or recommend you pause it. Paid traffic is an add-on we offer when it makes sense for your business, not the core of what we do.",
  },
  {
    q: "Do you handle my Google Business Profile, or do I?",
    a: "We handle it. You don't touch a thing unless you want to.",
  },
  {
    q: "Do I have to sign a contract?",
    a: "No. Month to month. You stay because it's working.",
  },
  {
    q: "What does it cost?",
    a: "Pricing depends on which tier fits your business and where you're starting from. The 45-minute call gives you a real number based on what's actually right for you, not a guess.",
  },
  {
    q: "Why don't you list prices on the page?",
    a: "Because flat pricing pretends every business is the same. Two HVAC companies in the same city can need very different setups based on their existing assets and goals. I'd rather give you a real recommendation than a one-size guess.",
  },
];
---

<BaseLayout>
  <!-- NAV -->
  <header
    class="sticky top-0 z-50 backdrop-blur-md bg-ink/80 border-b border-cream/5"
  >
    <div
      class="max-w-6xl mx-auto px-6 lg:px-8 h-16 flex items-center justify-between"
    >
      <a
        href="/"
        class="flex items-center gap-2.5"
        aria-label="Velocity Web Studio home"
      >
        <span
          class="inline-flex h-2.5 w-2.5 rounded-full bg-brand-500 shadow-[0_0_12px_var(--color-brand-500)]"
          aria-hidden="true"></span>
        <span
          class="font-display font-extrabold tracking-tight text-cream text-[17px]"
        >
          Velocity <span class="text-brand-500">Web</span>
        </span>
      </a>
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium">
        <a
          href="#destination"
          class="text-cream/70 hover:text-cream transition">Pillars</a
        >
        <a href="#ladder" class="text-cream/70 hover:text-cream transition"
          >Tiers</a
        >
        <a href="#about" class="text-cream/70 hover:text-cream transition"
          >About</a
        >
        <a href="#faq" class="text-cream/70 hover:text-cream transition">FAQ</a>
      </nav>
      <a
        href="#book"
        class="inline-flex items-center gap-1.5 rounded-full bg-brand-500 text-cream px-4 py-2 text-sm font-bold hover:bg-brand-600 transition shadow-lg shadow-brand-500/20"
      >
        Book a Call
      </a>
    </div>
  </header>

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div
      aria-hidden
      class="absolute -top-32 -right-40 h-[500px] w-[500px] rounded-full bg-brand-500/15 blur-3xl"
    >
    </div>
    <div
      aria-hidden
      class="absolute top-40 -left-40 h-[420px] w-[420px] rounded-full bg-brand-600/10 blur-3xl"
    >
    </div>

    <div
      class="relative max-w-4xl mx-auto px-6 lg:px-8 pt-20 lg:pt-28 pb-20 lg:pb-24 text-center"
    >
      <div
        class="inline-flex items-center gap-2 rounded-full border border-cream/10 bg-ink-2/70 px-3 py-1.5 text-xs font-semibold tracking-wide uppercase text-cream/65 backdrop-blur"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-brand-500 animate-pulse"
        ></span>
        Four pillars · One system · Boise & the Treasure Valley
      </div>

      <h1
        class="mt-7 font-display text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[0.98] text-balance text-cream"
      >
        Local dominance isn't a mystery.
        <span class="block mt-2 text-cream/40">
          It's a
          <span
            class="bg-gradient-to-r from-brand-500 via-brand-600 to-brand-400 bg-clip-text text-transparent"
            >destination.</span
          >
        </span>
      </h1>

      <p
        class="mt-7 text-lg md:text-xl text-cream/65 max-w-2xl mx-auto leading-relaxed text-pretty"
      >
        Every business that wins locally gets there through the same four
        pillars. We install all four, run them as one system, and the only
        variable is the speed you want to move.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="#book"
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 text-cream px-7 py-4 text-base font-bold shadow-xl shadow-brand-500/25 hover:bg-brand-600 transition-all"
        >
          Book a strategy call
          <span
            aria-hidden
            class="transition-transform group-hover:translate-x-1">→</span
          >
        </a>
        <a
          href="#destination"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-cream/15 text-cream px-7 py-4 text-base font-semibold hover:bg-ink-2 transition"
        >
          See the four pillars
        </a>
      </div>

      <p class="mt-4 text-sm text-cream/55 max-w-lg mx-auto">
        Free, 45 minutes, zero pressure. If we're not a fit, I'll tell you
        and point you somewhere useful.
      </p>

      <p class="mt-10 text-sm text-cream/45 tracking-wide">
        Built for local service businesses across Boise and the Treasure
        Valley.
      </p>
    </div>
  </section>

  <!-- STATS -->
  <section class="relative bg-ink-2 border-y border-cream/5">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-20 lg:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>Local search reality
          <span class="h-px w-8 bg-brand-500"></span>
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
        >
          The customers are already searching. The only question is whether
          your business shows up.
        </h2>
      </div>

      <div class="mt-14 grid grid-cols-2 lg:grid-cols-4 gap-5">
        {
          stats.map((s) => (
            <div class="rounded-2xl bg-ink-3 p-6 ring-1 ring-cream/5 text-center">
              <p class="text-4xl lg:text-5xl font-extrabold tracking-tight bg-gradient-to-br from-brand-500 to-brand-400 bg-clip-text text-transparent">
                {s.n}
              </p>
              <p class="mt-3 text-sm text-cream/65 leading-snug text-pretty">
                {s.l}
              </p>
            </div>
          ))
        }
      </div>

      <p
        class="mt-10 text-center text-lg text-cream/75 max-w-2xl mx-auto text-pretty"
      >
        If your business isn't installed as the answer to those searches, the
        business down the street is.
      </p>
    </div>
  </section>

  <!-- PROBLEM -->
  <section id="problem" class="relative bg-ink">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>The problem
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] text-balance text-cream"
        >
          You're not behind because you're bad at marketing.
          <span class="text-brand-500"
            >You're behind because the system isn't built.</span
          >
        </h2>
      </div>

      <div class="mt-12 space-y-6 text-lg leading-relaxed text-pretty">
        <p class="text-cream/85 font-medium">
          You already have customers. You're a good operator. The work you do
          is solid. The reason your phone isn't ringing the way it should
          isn't a skill problem.
        </p>

        <ul class="space-y-3">
          {
            problemPoints.map((p) => (
              <li class="flex items-start gap-3 rounded-xl bg-ink-2 ring-1 ring-cream/5 p-4 text-cream/80">
                <span
                  class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-500/15 text-brand-500 text-[11px] font-black"
                  aria-hidden="true"
                >
                  →
                </span>
                <span>It's that {p.charAt(0).toLowerCase() + p.slice(1)}</span>
              </li>
            ))
          }
        </ul>

        <p
          class="relative rounded-2xl bg-ink-2 ring-1 ring-cream/5 p-6 text-xl font-semibold leading-snug text-pretty text-cream"
        >
          <span
            aria-hidden
            class="absolute left-0 top-4 bottom-4 w-1 rounded-r-full bg-brand-500"
          ></span>
          <span class="block pl-3">
            The competitors ranking above you aren't better operators. They
            have the four pillars built and running. You don't. That's the
            entire difference.
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- DESTINATION (FOUR PILLARS) -->
  <section
    id="destination"
    class="relative bg-ink-2 border-y border-cream/5 overflow-hidden"
  >
    <div
      aria-hidden
      class="absolute top-1/2 -translate-y-1/2 -right-40 h-[420px] w-[420px] rounded-full bg-brand-500/8 blur-3xl"
    >
    </div>

    <div class="relative max-w-6xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl mx-auto text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>The destination
          <span class="h-px w-8 bg-brand-500"></span>
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
        >
          Four pillars, running as
          <span class="text-brand-500">one system.</span>
        </h2>
        <p class="mt-5 text-lg text-cream/65 leading-relaxed text-pretty">
          Every local service business that wins in their market arrives at
          the same place. These are the four assets that get them there.
        </p>
      </div>

      <div class="mt-14 grid md:grid-cols-2 gap-5">
        {
          pillars.map((p) => (
            <div class="group relative rounded-2xl bg-ink-3 p-7 lg:p-8 ring-1 ring-cream/5 hover:ring-brand-500/40 transition-all">
              <div class="flex items-center justify-between">
                <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-500">
                  {p.n}
                </p>
                <span
                  aria-hidden
                  class="h-1.5 w-1.5 rounded-full bg-brand-500/50 group-hover:bg-brand-500 transition"
                />
              </div>
              <h3 class="mt-3 font-display text-2xl lg:text-3xl font-bold tracking-tight text-cream leading-tight">
                {p.h}
              </h3>
              <p class="mt-4 text-[15px] text-cream/70 leading-relaxed text-pretty">
                {p.p}
              </p>
            </div>
          ))
        }
      </div>

      <p
        class="mt-10 text-center text-lg text-cream/80 max-w-2xl mx-auto text-pretty leading-relaxed"
      >
        No piece does the work alone. Built together as one system, they
        compound. <span class="text-cream font-semibold"
          >That's the destination.</span
        >
      </p>
    </div>
  </section>

  <!-- LADDER (TIERS) -->
  <section id="ladder" class="relative bg-ink">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl mx-auto text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>The ladder
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
        >
          Every Velocity client ends up at the same place.
          <span class="text-cream/40">The tier just determines how fast.</span>
        </h2>
        <p class="mt-5 text-lg text-cream/65 leading-relaxed text-pretty">
          Where you are now determines where we start. Where you want to be
          determines how fast we move.
        </p>
      </div>

      <div
        class="mt-14 grid lg:grid-cols-3 gap-5 items-stretch"
      >
        {
          tiers.map((t) => (
            <div
              class:list={[
                "relative flex flex-col rounded-2xl p-7 ring-1 transition-all",
                t.highlighted
                  ? "bg-ink-3 ring-brand-500/50 lg:scale-[1.03] shadow-2xl shadow-brand-500/10"
                  : "bg-ink-2 ring-cream/5 hover:ring-cream/15",
              ]}
            >
              {t.badge && (
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 inline-flex items-center gap-1.5 rounded-full bg-brand-500 text-cream px-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] whitespace-nowrap shadow-lg shadow-brand-500/30">
                  {t.badge}
                </div>
              )}

              <div>
                <h3 class="font-display text-3xl font-extrabold tracking-tight text-cream">
                  {t.name}
                </h3>
                <p class="mt-1 text-[10px] font-bold uppercase tracking-[0.22em] text-brand-500">
                  {t.tag}
                </p>
              </div>

              <div class="mt-6 pb-5 border-b border-cream/5">
                <p class="text-xs font-bold uppercase tracking-wider text-cream/40">
                  Best for
                </p>
                <p class="mt-1.5 text-[15px] text-cream/90 font-medium leading-snug text-pretty">
                  {t.best}
                </p>
              </div>

              <p class="mt-5 text-[15px] text-cream/70 leading-relaxed text-pretty flex-1">
                {t.body}
              </p>

              <a
                href="#book"
                class:list={[
                  "mt-7 inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-bold transition-all",
                  t.highlighted
                    ? "bg-brand-500 text-cream hover:bg-brand-600 shadow-lg shadow-brand-500/20"
                    : "bg-cream/5 text-cream ring-1 ring-cream/10 hover:bg-cream/10",
                ]}
              >
                Talk about {t.name} <span aria-hidden>→</span>
              </a>
            </div>
          ))
        }
      </div>

      <p
        class="mt-10 text-center text-base text-cream/55 max-w-2xl mx-auto text-pretty leading-relaxed"
      >
        Pricing depends on your business, your starting point, and the speed
        you want to move. The strategy call is where we figure out which tier
        fits and what it costs for your situation.
      </p>
    </div>
  </section>

  <!-- WHY THIS WORKS (DIFFERENTIATORS) -->
  <section id="solution" class="relative bg-ink">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl mx-auto text-center">
        <p
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
        >
          <span class="h-px w-8 bg-brand-500"></span>Why this works
        </p>
        <h2
          class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
        >
          Why this works when the other things haven't.
        </h2>
      </div>

      <div class="mt-14 grid md:grid-cols-2 gap-5">
        {
          differentiators.map((d, i) => (
            <div class="group relative rounded-2xl bg-ink-2 p-7 ring-1 ring-cream/5 hover:ring-brand-500/40 hover:shadow-xl hover:shadow-brand-500/5 transition-all">
              <span class="text-[10px] font-bold uppercase tracking-widest text-cream/30">
                0{i + 1}
              </span>
              <h3 class="mt-3 text-lg font-bold tracking-tight text-brand-500 leading-snug">
                {d.h}
              </h3>
              <p class="mt-3 text-[15px] text-cream/65 leading-relaxed text-pretty">
                {d.p}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="relative bg-ink-2 border-y border-cream/5">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-24 lg:py-32">
      <div class="grid lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <p
            class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-500"
          >
            <span class="h-px w-8 bg-brand-500"></span>About me
          </p>
          <h2
            class="mt-4 font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-balance text-cream"
          >
            The guy who'll actually be running your account.
